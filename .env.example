# Wallet / Chain
# Circle Bridge Kit browser-wallet bridging needs no API key or entity secret.
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=
# Private server/API/cron RPC endpoint, e.g. your dRPC Arc Testnet URL.
# Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
ARC_RPC_URL=
# Backward-compatible server-only alias used by the current Vercel project.
ARC_TESTNET_RPC_URL=
NEXT_PUBLIC_ARC_TESTNET_CHAIN_ID=
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=
# Native gas token is USDC (18-decimal accounting). The ERC-20 USDC interface
# at 0x3600000000000000000000000000000000000000 uses 6 decimals for transfers.
# Not read by the app. A stale Vercel value previously overrode the live
# 0x4f33115… deployment. Change src/lib/contracts.ts after verifying a new one.
NEXT_PUBLIC_ARCSIGNAL_CONTRACT_ADDRESS=
# Set true only for a verified deployment of the refund-capable contract revision.
NEXT_PUBLIC_ARCSIGNAL_CANCEL_REFUNDS=false

# ArcSignal V2 remains disabled unless both values are present. Populate only
# after the deployment runbook's on-chain verification and canary checks pass.
NEXT_PUBLIC_ARCSIGNAL_V2_FACTORY_ADDRESS=
NEXT_PUBLIC_ARCSIGNAL_V2_DEPLOYMENT_BLOCK=
V2_INDEX_CONFIRMATIONS=1
V2_INDEX_CHUNK_SIZE=2000

# AI (Configured for Gemini or Groq)
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Sports Data
API_FOOTBALL_KEY=

# Cron Security
CRON_SECRET=
DATABASE_URL=
# Arc has deterministic sub-second finality, so one confirmation is normally enough.
# Raise this if RPC lag, provider inconsistency, or production policy requires it.
INDEX_CONFIRMATIONS=1
# Maximum finalized block span fetched in one atomic chunk.
INDEX_CHUNK_SIZE=9000
# Maximum chunks committed by a single cron invocation.
INDEX_MAX_CHUNKS_PER_RUN=8
# First block containing events for the currently deployed ArcSignal contract.
ARCSIGNAL_DEPLOYMENT_BLOCK=50346816

# Server-only media provider credential. Rotate any value previously committed.
IMGBB_API_KEY=

# Admin wallet secrets - keep in the deployment secret store, never commit.
RESOLVER_PRIVATE_KEY=
# Fail-closed gate for market creation and resolution. Leave false until the
# resolver signer, idempotency, oracle policy, and production schedule are verified.
ENABLE_MARKET_AUTOMATION=false
ENABLE_V2_MAINTENANCE=false
# Separate one-time gate for the legacy-contract migration script.
ENABLE_CONTRACT_MIGRATION=false
DEPLOYER_PRIVATE_KEY=

# V2 deployment inputs (server/deployment environment only)
EXPECTED_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
OPTIMISTIC_ORACLE_ADDRESS=
PROTOCOL_ADMIN=
MARKET_CREATOR=
RESOLUTION_OPERATOR=
PAUSE_GUARDIAN=
PROTOCOL_TREASURY=
PROTOCOL_FEE_BPS=50
LP_FEE_BPS=100
ORACLE_IDENTIFIER=
ORACLE_MIN_LIVENESS=7200
ORACLE_MAX_LIVENESS=604800
ORACLE_MIN_BOND=10000000
ORACLE_RULES_HASH=
ORACLE_RULES_URI=
CATEGORY_METADATA_BASE_URI=
