# Wallet / Chain
NEXT_PUBLIC_ARC_APPKIT_PROJECT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=
# Private server/API/cron RPC endpoint, e.g. your dRPC Arc Testnet URL.
# Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
ARC_RPC_URL=
# Backward-compatible server-only alias used by the current Vercel project.
ARC_TESTNET_RPC_URL=
NEXT_PUBLIC_ARC_TESTNET_CHAIN_ID=
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=
NEXT_PUBLIC_ARCSIGNAL_CONTRACT_ADDRESS=

# AI (Configured for Gemini or Groq)
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Sports Data
API_FOOTBALL_KEY=

# Cron Security
CRON_SECRET=
DATABASE_URL=
# Number of chain blocks that must follow a block before it is indexed.
INDEX_CONFIRMATIONS=12
# Maximum finalized block span fetched in one atomic chunk.
INDEX_CHUNK_SIZE=9000
# Maximum chunks committed by a single cron invocation.
INDEX_MAX_CHUNKS_PER_RUN=8
# First block containing events for the currently deployed ArcSignal contract.
ARCSIGNAL_DEPLOYMENT_BLOCK=50346816

# Server-only media provider credential. Rotate any value previously committed.
IMGBB_API_KEY=

# Admin wallet secrets - keep in the deployment secret store, never commit.
RESOLVER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
