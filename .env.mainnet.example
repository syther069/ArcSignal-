# ArcSignal V2 — Arc Mainnet template. Never put secrets in this file.
# Mainnet has real USDC. Do not include any *_TESTNET_* values here.
NEXT_PUBLIC_ARC_NETWORK=mainnet
NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_RPC_URL=https://rpc.mainnet.arc.io
EXPECTED_CHAIN_ID=5042
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# USDC has 6 decimals: Conservative canary caps each market at $10k, protocol-wide
# outstanding collateral at $100k, and initial AMM seed liquidity at $1k.
MAX_MARKET_COLLATERAL=10000000000
MAX_PROTOCOL_COLLATERAL=100000000000
MAX_INITIAL_LIQUIDITY=1000000000

# Populate only after the verified, audited deployment and manifest registration.
NEXT_PUBLIC_ARCSIGNAL_V2_FACTORY_ADDRESS=
NEXT_PUBLIC_ARCSIGNAL_V2_DEPLOYMENT_BLOCK=
V2_INDEX_CONFIRMATIONS=1
V2_INDEX_CHUNK_SIZE=2000

# Mainnet must use a production dispute/arbitration oracle. A testnet shim is forbidden.
DEPLOY_TESTNET_ORACLE=false
OPTIMISTIC_ORACLE_ADDRESS=
ORACLE_IDENTIFIER=
ORACLE_MIN_LIVENESS=
ORACLE_MAX_LIVENESS=
ORACLE_MIN_BOND=
ORACLE_RULES_HASH=
ORACLE_RULES_URI=
CATEGORY_METADATA_BASE_URI=

# All five addresses must be independently controlled production accounts.
PROTOCOL_ADMIN=
MARKET_CREATOR=
RESOLUTION_OPERATOR=
PAUSE_GUARDIAN=
PROTOCOL_TREASURY=
PROTOCOL_FEE_BPS=50
LP_FEE_BPS=100

# Server-only values — store them in the deployment platform's secret manager.
DEPLOYER_PRIVATE_KEY=
RESOLVER_PRIVATE_KEY=
CRON_SECRET=
DATABASE_URL=
GIT_COMMIT=

# Keep automation disabled until the canary and incident gates pass.
ENABLE_MARKET_AUTOMATION=false
ENABLE_V2_MAINTENANCE=false

# Grok (xAI) as a fourth scored agent. Leave empty to run without it.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# On-chain anchoring of AI signal hashes (SignalAnchor contract). Use a dedicated key, not the admin.
ENABLE_SIGNAL_ANCHORING=false
SIGNAL_ANCHOR_ADDRESS=
ANCHOR_PRIVATE_KEY=

# X Pulse: Grok reads live X mood per open market (uses XAI_API_KEY). Max markets per run caps cost.
ENABLE_X_PULSE=false
XAI_PULSE_MAX_MARKETS=5

# Grok Phase 2. Price-move notes + crowd/price baselines job, and the Ask Grok chat (both use XAI_API_KEY).
ENABLE_PRICE_MOVES=false
ENABLE_ASK_GROK=false
NEXT_PUBLIC_ENABLE_ASK_GROK=false
XAI_ASK_DAILY_LIMIT=300

# Grok Phase 3. Markets drafted from X trends (published only after operator approval), evidence packs after close.
ENABLE_TREND_DRAFTS=false
ENABLE_EVIDENCE_PACKS=false
# Long random secret for /ops/drafts (operator review page). Never share it.
OPS_ADMIN_SECRET=

# Trending-sentiment market drafts. How often Grok is asked (hours), ideas per ask, and 4 extra coins (DOGE, BNB, LINK, TON).
# TREND_EXTRA_SYMBOLS must match on the site AND the resolver, or extra-coin markets cannot settle.
TREND_DRAFT_INTERVAL_HOURS=2
TREND_DRAFT_MAX_IDEAS=5
TREND_EXTRA_SYMBOLS=false

# V2 settlement. Keep false until a real settlement oracle is registered (oracle policy version below).
# While false, the market job never creates V2 markets and V2 pages say settlement is not live.
ENABLE_V2_SETTLEMENT=false
NEXT_PUBLIC_V2_SETTLEMENT_LIVE=false
ARCSIGNAL_V2_ORACLE_POLICY_VERSION=1
# USDC a disputer posts to challenge a proposed V2 result. Must be >= SETTLEMENT_MIN_BOND in the oracle policy.
ARCSIGNAL_V2_DISPUTE_BOND_USDC=25
# Key the settle-v2 job uses to propose results (the oracle proposer). Falls back to RESOLVER_PRIVATE_KEY. Keep it separate from the admin.
SETTLEMENT_PROPOSER_PRIVATE_KEY=
