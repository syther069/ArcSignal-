# ArcSignal V2 — Arc Mainnet template. Never put secrets in this file.
# Mainnet has real USDC. Do not include any *_TESTNET_* values here.
NEXT_PUBLIC_ARC_NETWORK=mainnet
NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_RPC_URL=https://rpc.mainnet.arc.io
EXPECTED_CHAIN_ID=5042
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# USDC has 6 decimals: Conservative canary caps each market at $10k, protocol-wide
# outstanding collateral at $100k, and initial AMM seed liquidity at $1k.
MAX_MARKET_COLLATERAL=10000000000
MAX_PROTOCOL_COLLATERAL=100000000000
MAX_INITIAL_LIQUIDITY=1000000000

# Populate only after the verified, audited deployment and manifest registration.
NEXT_PUBLIC_ARCSIGNAL_V2_FACTORY_ADDRESS=
NEXT_PUBLIC_ARCSIGNAL_V2_DEPLOYMENT_BLOCK=
V2_INDEX_CONFIRMATIONS=1
V2_INDEX_CHUNK_SIZE=2000

# Mainnet must use a production dispute/arbitration oracle. A testnet shim is forbidden.
DEPLOY_TESTNET_ORACLE=false
OPTIMISTIC_ORACLE_ADDRESS=
ORACLE_IDENTIFIER=
ORACLE_MIN_LIVENESS=
ORACLE_MAX_LIVENESS=
ORACLE_MIN_BOND=
ORACLE_RULES_HASH=
ORACLE_RULES_URI=
CATEGORY_METADATA_BASE_URI=

# All five addresses must be independently controlled production accounts.
PROTOCOL_ADMIN=
MARKET_CREATOR=
RESOLUTION_OPERATOR=
PAUSE_GUARDIAN=
PROTOCOL_TREASURY=
PROTOCOL_FEE_BPS=50
LP_FEE_BPS=100

# Server-only values — store them in the deployment platform's secret manager.
DEPLOYER_PRIVATE_KEY=
RESOLVER_PRIVATE_KEY=
CRON_SECRET=
DATABASE_URL=
GIT_COMMIT=

# Keep automation disabled until the canary and incident gates pass.
ENABLE_MARKET_AUTOMATION=false
ENABLE_V2_MAINTENANCE=false
