{
  "name": "arcsignal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src next.config.mjs tailwind.config.ts",
    "test": "vitest run",
    "audit:baseline": "node scripts/check-audit-baseline.mjs",
    "check:bundles": "node scripts/check-bundle-budgets.mjs",
    "generate": "npx tsx scripts/run-generate.ts",
    "resolve": "npx tsx scripts/run-resolve.ts",
    "db:migrate": "npx tsx scripts/migrate-db.ts",
    "ops:check-markets": "npx tsx scripts/diagnostics/check-markets.ts",
    "ops:check-owner": "npx tsx scripts/diagnostics/check-owner.ts",
    "ops:check-v2": "npx tsx scripts/diagnostics/check-v2.ts",
    "contracts:build": "forge build --sizes",
    "contracts:test": "forge test",
    "ops:scheduler": "npx tsx scripts/operations/scheduler.ts",
    "promote:live": "npx tsx scripts/run-promote-live.ts",
    "settle:external": "npx tsx scripts/run-settle-external.ts",
    "promote:external:all": "powershell -ExecutionPolicy Bypass -File scripts/promote-all-external.ps1"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.17.1",
    "@circle-fin/bridge-kit": "^1.14.1",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.41.0",
    "dotenv": "^17.4.2",
    "groq-sdk": "^0.9.1",
    "lucide-react": "^1.21.0",
    "next": "16.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "2.12.7",
    "tailwindcss": "3.4.4",
    "typescript": "5.9.3",
    "unstorage": "^1.17.5",
    "viem": "2.56.3",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "solc": "^0.8.35",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x"
  }
}
